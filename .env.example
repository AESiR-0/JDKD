# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Public site origin, used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=

# Enquiry forms → Google Apps Script web app. Setup steps: apps-script/Code.gs.
# Server-only: never prefix these with NEXT_PUBLIC_.
# The Apps Script web app URL (ends in /exec).
ENQUIRY_WEBHOOK_URL=
# Must be exactly the script's SHARED_SECRET property.
ENQUIRY_WEBHOOK_SECRET=
