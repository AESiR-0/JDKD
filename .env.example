# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Public site origin, used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=

# Enquiry forms → Google Apps Script web app (apps-script/Code.gs).
# Both optional. Server-only: never prefix these with NEXT_PUBLIC_.
# Overrides the deployed /exec URL built into src/app/api/enquiry/route.ts.
ENQUIRY_WEBHOOK_URL=
# Only if the script has a SHARED_SECRET property; must match it exactly.
ENQUIRY_WEBHOOK_SECRET=
