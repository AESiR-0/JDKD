# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ide
.claude/

.vercel

# Client footage — 2.1 GB of raw drone/camera source.
# The zip and the extracted originals stay OUT of the repo and off the CDN.
# Only the transcoded web derivatives in public/video/ are committed.
/public/*.zip
/assets-source/

# Client source drops extracted into public/. These are raw camera/drone
# originals — gigabytes of them — and public/ is served verbatim, so anything
# left here would deploy. Only the transcoded derivatives in public/video and
# public/images are committed.
/public/A-11/
/public/A23/
/public/M-82/
/public/M39/
/.tmp-hls-src/
